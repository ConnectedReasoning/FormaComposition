{
  "title": "LANTERN",
  "key": "D Dorian",
  "bpm": 112,
  "meter": "4/4",
  "bars_per_section": 28,
  "section_seconds": 60,
  "total_minutes": 60,
  "feel": "warmer, bouncier arpeggio focus music; marimba and pluck timbres",
  "join_rules": [
    "No section modulates: every chord stays diatonic to the key, so any section can follow any other.",
    "The last bar of every section resolves to the tonic chord, replacing the last chord of the final loop.",
    "Overlap the last beat of each section with the first beat of the next so tails ring through.",
    "Each section's progression_loop repeats every 4 bars; phrase_arc says which layers enter or leave per phrase."
  ],
  "mix_rules": [
    "Melody stays quiet and mostly stepwise; the arp pulse carries the focus work.",
    "Soft timbres only (pluck, marimba, felt piano, bells); no harsh saws or vocals.",
    "Keep dynamics within about 6 dB across the whole hour."
  ],
  "play_variants": [
    {
      "play": 1,
      "name": "as written",
      "change": "none"
    },
    {
      "play": 2,
      "name": "register up",
      "change": "arp +1 octave; melody inverted"
    },
    {
      "play": 3,
      "name": "rhythm mask",
      "change": "drop arp steps 5 and 13 of 16 (3 and 7 of 8); staccato gate"
    },
    {
      "play": 4,
      "name": "reverse and ghost",
      "change": "arp direction reversed; ghost notes at 25% velocity"
    },
    {
      "play": 5,
      "name": "slow melody, moving filter",
      "change": "melody note lengths doubled; filter cutoff opens then closes across the section"
    },
    {
      "play": 6,
      "name": "register down",
      "change": "arp -1 octave; melody drops its last note; alternate arp notes panned left/right"
    }
  ],
